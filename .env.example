# Docker Compose credentials
S3_ROOT_PASSWORD=replace-with-minio-password
DB_PASSWORD=replace-with-postgres-password
QDRANT_API_KEY=replace-with-qdrant-key

# Gateway
MODEL_LLM_BASE_URL=http://localhost:8000/v1
MODEL_OCR_BASE_URL=http://localhost:8002/v1
LLM_API_KEY=replace-with-llm-api-key
CORS_ALLOW_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Backend database connection
DATABASE_URL=postgresql+asyncpg://llmops:replace-with-postgres-password@localhost:5432/llmops

# Backend MinIO connection
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=replace-with-minio-password
MINIO_BUCKET=cv-files
MINIO_SECURE=false

# RAG service configuration
OPENAI_API_KEY=replace-with-rag-provider-key
CUSTOM_API_BASE=http://localhost:8004/v1

TAVILY_API_KEY=...
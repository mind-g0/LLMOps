# --- Parsing benchmark: real people's resumes (PII) — never commit raw data ---
eval/parsing_benchmark/data/raw/
eval/parsing_benchmark/data/samples/
# Ground truth for hand-authored/non-PII synthetic data is fine to keep —
# uncomment the next line instead of the blanket rule above if you want that:
# eval/parsing_benchmark/data/ground_truth/*/  (everything except arabic_synthetic_cv/)
eval/parsing_benchmark/data/ground_truth/

# Model outputs on real PII documents — also don't commit
eval/parsing_benchmark/results/ocr/
eval/parsing_benchmark/results/docling/
eval/parsing_benchmark/results/qianfan_ocr/
eval/parsing_benchmark/results/baseer/
eval/parsing_benchmark/results/glm_ocr/

# Metrics CSVs and comparison reports are just numbers, not PII — keep these:
!eval/parsing_benchmark/results/metrics_*.csv
!eval/parsing_benchmark/reports/


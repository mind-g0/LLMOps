# ── Model endpoints (backend gateway routes to the right model via task_type) ──
LLM_API_BASE=http://localhost:8004/v1
VLM_API_BASE=http://localhost:8004/v1

# Override model names if the gateway's auto-discovery picks the wrong one
# LLM_MODEL=/models/Qwen3.5-9B
# VLM_MODEL=/models/Qwen3-VL-8B-Instruct

# ── API key (same key the backend uses to reach vLLM/OCR) ──
LLM_API_KEY=your-llm-api-key

# ── Qdrant (agent uses its own Qdrant for vector storage; embedded mode if empty) ──
QDRANT_URL=
QDRANT_API_KEY=

# ── Embedding model (pulled from HuggingFace on first run) ──
# EMBEDDING_MODEL=BAAI/bge-m3
HF_TOKEN=

# ── Web search for course recommendations ──
TAVILY_API_KEY=

# ── Backend API (for fetching jobs and CVs instead of local files/Qdrant) ──
BACKEND_API_BASE=http://localhost:8004

# ── Agent internals ──
GATEWAY_STREAM=1           # stream every request (avoids gateway timeout on long generations)
# DSPY_CACHE=false
# LOG_PROMPTS=false